# OS clutter — these are generated by Windows/Mac, never needed
.DS_Store
Thumbs.db
desktop.ini

# VS Code settings — your personal editor config, irrelevant to the website
.vscode/

# Node modules — if you ever install npm packages, never push these
node_modules/

# Environment files — CRITICAL: these store secret keys, never push
.env
.env.local
.env.production

# Build output folders — if you add a build step later
dist/
build/

# Log files
*.log
npm-debug.log*